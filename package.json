{
  "name": "a11y-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for WCAG criteria lookup, accessibility pattern checking, and remediation guidance",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && cp -r src/data dist/",
    "start": "node dist/index.js",
    "dev": "tsc --watch"
  },
